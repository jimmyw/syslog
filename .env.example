# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:            https://syslog.wennlund.nu
#   Authorization callback URL: https://syslog.wennlund.nu/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Second, separate GitHub OAuth App for the MCP OAuth authorization server
# (classic OAuth Apps allow only one callback URL, and the first is taken by oauth2-proxy)
#   Homepage URL:            https://syslog.wennlund.nu
#   Authorization callback URL: https://syslog.wennlund.nu/mcp/oauth/github/callback
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=

# Random 32-char secret for session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_COOKIE_SECRET=

# Required: comma-separated GitHub usernames allowed to log in.
# Wired into oauth2-proxy via --github-user=${GITHUB_ALLOWED_USERS}.
# Login fails for anyone not listed here.
GITHUB_ALLOWED_USERS=jimmywennlund
